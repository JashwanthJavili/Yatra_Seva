# ============================================================
# Yatra Seva Portal — Firebase Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual Firebase
# Web App configuration values from:
#   Firebase Console → Project Settings → Your apps → Config
#
# NEVER put real values in this file — it is committed to git.
# NEVER use a Firebase service-account private key here.
# ============================================================

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
